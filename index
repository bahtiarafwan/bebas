            {
                q: "9. Tiga elemen utama dalam pendekatan Deep Learning adalah...",
                options: [
                    "A. Fast, Hard, & Boring Learning",
                    "B. Meaningful, Mindful, & Joyful Learning",
                    "C. Reading, Writing, & Memorizing",
