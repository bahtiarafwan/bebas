        window.addEventListener('load', () => {
            // Hide loading overlay
            setTimeout(() => {
                const loader = document.getElementById('loadingScreen');
                if (loader) {
                    loader.classList.add('opacity-0');
                    setTimeout(() => loader.remove(), 500);
                }
            }, 600);

            // Initialize App Components
            initScrollProgress();
            initDarkMode();
            renderQuizQuestion();
            loadReflectionNotes();
            updateBookmarkBadge();
            updateOverallProgressBar();
            setupSearch();
        });

        // Scroll Progress Bar
        function initScrollProgress() {
            window.addEventListener('scroll', () => {
                const winScroll = document.body.scrollTop || document.documentElement.scrollTop;
                const height = document.documentElement.scrollHeight - document.documentElement.clientHeight;
                const scrolled = (winScroll / height) * 100;
                document.getElementById('scrollProgressBar').style.width = scrolled + '%';
            });
        }

        // Dark Mode Controller
        function initDarkMode() {
            const darkModeBtn = document.getElementById('darkModeBtn');
            const darkModeIcon = document.getElementById('darkModeIcon');
            
            if (localStorage.getItem('ecoHist_theme') === 'dark' || 
                (!('ecoHist_theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.classList.add('dark');
                darkModeIcon.className = 'fa-solid fa-sun text-base';
            }

            darkModeBtn.addEventListener('click', () => {
                if (document.documentElement.classList.contains('dark')) {
                    document.documentElement.classList.remove('dark');
                    localStorage.setItem('ecoHist_theme', 'light');
                    darkModeIcon.className = 'fa-solid fa-moon text-base';
                } else {
                    document.documentElement.classList.add('dark');
                    localStorage.setItem('ecoHist_theme', 'dark');
                    darkModeIcon.className = 'fa-solid fa-sun text-base';
                }
            });

            // Mobile Menu Toggle
            document.getElementById('mobileMenuBtn').addEventListener('click', () => {
                document.getElementById('mobileMenu').classList.toggle('hidden');
            });

            document.querySelectorAll('.mobile-nav-link').forEach(link => {
                link.addEventListener('click', () => {
                    document.getElementById('mobileMenu').classList.add('hidden');
                });
            });
        }

        // Switch Active Module
        function switchModule(modNum) {
            currentModule = modNum;

            // Update Tab UI
            document.querySelectorAll('.mod-tab-btn').forEach((btn, idx) => {
                if (idx + 1 === modNum) {
                    btn.className = 'mod-tab-btn active w-full text-left p-3 rounded-xl font-medium text-xs sm:text-sm flex items-center justify-between transition bg-lampung-green text-white shadow-sm';
                } else {
                    btn.className = 'mod-tab-btn w-full text-left p-3 rounded-xl font-medium text-xs sm:text-sm flex items-center justify-between transition text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-lampung-darkborder';
                }
            });

            // Hide all module content views
            document.querySelectorAll('.module-view').forEach(view => view.classList.add('hidden'));
            
            // Show selected module content view
            const target = document.getElementById(`moduleContent${modNum}`);
            if (target) target.classList.remove('hidden');

            // Update Breadcrumb & Controls
            const titles = [
                "Modul 1: Pengantar Sejarah Lokal", "Modul 2: Perjalanan Sejarah Lampung", 
                "Modul 3: Kearifan Lokal Lampung", "Modul 4: Ecopedagogy Sejarah",
                "Modul 5: Pendekatan Deep Learning", "Modul 6: Green History Lampung",
                "Modul 7: Studi Kasus Alih Fungsi", "Modul 8: Project Based Learning",
                "Modul 9: Ringkasan & Mind Map"
            ];
            document.getElementById('breadcrumbModuleTitle').innerText = titles[modNum - 1];

            updateBookmarkBtnUI();
            updateCompleteBtnUI();
        }

        // Bookmark Logic
        function toggleBookmarkCurrentModule() {
            const index = bookmarkedModules.indexOf(currentModule);
            if (index > -1) {
                bookmarkedModules.splice(index, 1);
            } else {
                bookmarkedModules.push(currentModule);
            }
            localStorage.setItem('ecoHist_bookmarks', JSON.stringify(bookmarkedModules));
            updateBookmarkBtnUI();
            updateBookmarkBadge();
            renderBookmarkDrawerItems();
        }

        function updateBookmarkBtnUI() {
            const isBookmarked = bookmarkedModules.includes(currentModule);
            const icon = document.getElementById('bookmarkIcon');
            const text = document.getElementById('bookmarkText');
            if (isBookmarked) {
                icon.className = 'fa-solid fa-bookmark text-lampung-gold';
                text.innerText = 'Tersimpan';
            } else {
                icon.className = 'fa-regular fa-bookmark';
                text.innerText = 'Simpan Bookmark';
            }
        }

        function updateBookmarkBadge() {
            document.getElementById('bookmarkBadge').innerText = bookmarkedModules.length;
        }

        // Bookmark Drawer Toggle
        document.getElementById('bookmarkDrawerBtn').addEventListener('click', toggleBookmarkDrawer);
        function toggleBookmarkDrawer() {
            const drawer = document.getElementById('bookmarkDrawer');
            drawer.classList.toggle('translate-x-full');
            renderBookmarkDrawerItems();
        }

        function renderBookmarkDrawerItems() {
            const container = document.getElementById('bookmarkListContainer');
            if (bookmarkedModules.length === 0) {
                container.innerHTML = '<p class="text-gray-400 italic">Belum ada modul yang disimpan.</p>';
                return;
            }

            container.innerHTML = bookmarkedModules.map(m => `
                <div class="p-2.5 rounded-xl bg-gray-100 dark:bg-lampung-darkborder flex items-center justify-between cursor-pointer hover:bg-lampung-green hover:text-white transition" onclick="switchModule(${m}); toggleBookmarkDrawer();">
                    <span class="font-bold">Modul ${m}</span>
                    <i class="fa-solid fa-arrow-right"></i>
                </div>
            `).join('');
        }

        // Module Completion
        function toggleModuleCompletion() {
            const index = completedModules.indexOf(currentModule);
            if (index > -1) {
                completedModules.splice(index, 1);
            } else {
                completedModules.push(currentModule);
            }
            localStorage.setItem('ecoHist_completed', JSON.stringify(completedModules));
            updateCompleteBtnUI();
            updateOverallProgressBar();
        }

        function updateCompleteBtnUI() {
            const isCompleted = completedModules.includes(currentModule);
            const icon = document.getElementById('completeIcon');
            const text = document.getElementById('completeText');
            if (isCompleted) {
                icon.className = 'fa-solid fa-circle-check text-lampung-green';
                text.innerText = 'Selesai';
            } else {
                icon.className = 'fa-regular fa-circle-check';
                text.innerText = 'Selesai Dibaca';
            }
        }

        function updateOverallProgressBar() {
            const percent = Math.round((completedModules.length / 9) * 100);
            document.getElementById('overallProgressBar').style.width = percent + '%';
            document.getElementById('overallProgressPercent').innerText = percent + '%';
        }

        // Accordion Toggle
        function toggleAccordion(id) {
            const content = document.getElementById(id);
            const icon = document.getElementById(id + 'Icon');
            if (content.classList.contains('hidden')) {
                content.classList.remove('hidden');
                icon.classList.add('rotate-180');
            } else {
                content.classList.add('hidden');
                icon.classList.remove('rotate-180');
            }
        }

        // Check Module 1 Practice Quiz
        function checkM1Quiz() {
            const correctOption = document.getElementById('m1correct');
            const feedback = document.getElementById('m1QuizFeedback');
            feedback.classList.remove('hidden');
            if (correctOption.checked) {
                feedback.className = 'text-xs font-bold mt-2 text-lampung-green dark:text-lampung-green-light';
                feedback.innerText = 'Jawaban Tepat! Sejarah lokal terikat erat dengan ekosistem dan ruang hidup setempat.';
            } else {
                feedback.className = 'text-xs font-bold mt-2 text-red-600';
                feedback.innerText = 'Jawaban belum tepat. Coba pilih opsi B.';
            }
        }

        // Module Search Filter
        function setupSearch() {
            document.getElementById('materiSearchInput').addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase();
                document.querySelectorAll('.mod-tab-btn').forEach((btn, idx) => {
                    const text = btn.innerText.toLowerCase();
                    btn.style.display = text.includes(term) ? 'flex' : 'none';
                });
            });
        }

        // Quiz Engine Functions
        function renderQuizQuestion() {
            const q = quizData[currentQuizIndex];
            document.getElementById('quizQuestionTracker').innerText = `Pertanyaan ${currentQuizIndex + 1} dari ${quizData.length}`;
            document.getElementById('quizQuestionText').innerText = q.q;

            const optionsContainer = document.getElementById('quizOptionsContainer');
            optionsContainer.innerHTML = q.options.map((opt, idx) => `
                <button onclick="selectQuizOption(${idx})" class="w-full text-left p-3.5 rounded-xl border ${userQuizAnswers[currentQuizIndex] === idx ? 'border-lampung-green bg-lampung-green/10 dark:bg-lampung-green/20' : 'border-gray-200 dark:border-lampung-darkborder bg-gray-50 dark:bg-lampung-darkborder/30'} hover:border-lampung-green transition text-xs sm:text-sm font-medium text-gray-800 dark:text-gray-200">
                    ${opt}
                </button>
            `).join('');

            // Prev Button Visibility
            document.getElementById('prevQuizBtn').classList.toggle('hidden', currentQuizIndex === 0);
            document.getElementById('nextQuizBtn').innerText = currentQuizIndex === quizData.length - 1 ? 'Selesai Kuis' : 'Selanjutnya';
        }

        function selectQuizOption(optIndex) {
            userQuizAnswers[currentQuizIndex] = optIndex;
            renderQuizQuestion();
        }

        function nextQuestion() {
            if (currentQuizIndex < quizData.length - 1) {
                currentQuizIndex++;
                renderQuizQuestion();
            } else {
                finishQuiz();
            }
        }

        function prevQuestion() {
            if (currentQuizIndex > 0) {
                currentQuizIndex--;
                renderQuizQuestion();
            }
        }

        function finishQuiz() {
            let correctCount = 0;
            quizData.forEach((q, idx) => {
                if (userQuizAnswers[idx] === q.answer) correctCount++;
            });

            quizScore = Math.round((correctCount / quizData.length) * 100);

            document.getElementById('quizContainer').classList.add('hidden');
            document.getElementById('quizResultPanel').classList.remove('hidden');
            document.getElementById('quizFinalScoreText').innerText = `Skor Anda: ${quizScore} / 100 (${correctCount} benar dari ${quizData.length} soal)`;

            const feedback = document.getElementById('quizFeedbackMessage');
            const certContainer = document.getElementById('certificateContainer');

            if (quizScore >= 80) {
                feedback.innerText = 'Luas biasa! Kamu memiliki pemahaman mendalam tentang Sejarah Lokal Lampung & Ecopedagogy.';
                certContainer.classList.remove('hidden');
            } else {
                feedback.innerText = 'Nilaimu belum mencapai batas kelulusan sertifikat (minimal 80). Silakan ulas kembali modul dan coba lagi!';
                certContainer.classList.add('hidden');
            }
        }

        function resetQuiz() {
            currentQuizIndex = 0;
            quizScore = 0;
            userQuizAnswers = {};
            document.getElementById('quizResultPanel').classList.add('hidden');
            document.getElementById('quizContainer').classList.remove('hidden');
            renderQuizQuestion();
        }

        // Reflection Journal LocalStorage Sync
        function saveReflectionNotes() {
            const p1 = document.getElementById('refleksiPrompt1').value;
            const p2 = document.getElementById('refleksiPrompt2').value;
            const p3 = document.getElementById('refleksiPrompt3').value;

            const reflections = { p1, p2, p3, timestamp: new Date().toISOString() };
            localStorage.setItem('ecoHist_reflections', JSON.stringify(reflections));

            const status = document.getElementById('reflectionSaveStatus');
            status.classList.remove('hidden');
            setTimeout(() => status.classList.add('hidden'), 3000);
        }

        function loadReflectionNotes() {
            const saved = JSON.parse(localStorage.getItem('ecoHist_reflections'));
            if (saved) {
                if (saved.p1) document.getElementById('refleksiPrompt1').value = saved.p1;
                if (saved.p2) document.getElementById('refleksiPrompt2').value = saved.p2;
                if (saved.p3) document.getElementById('refleksiPrompt3').value = saved.p3;
            }
        }

        // Map Interactive Detail Viewer
        function showMapDetail(title, history, ecoValue, region) {
            document.getElementById('mapTitle').innerText = title;
            document.getElementById('mapHistory').innerText = history;
            document.getElementById('mapEcoValue').innerText = ecoValue;
        }

        // Case Study Modal
        function openCaseStudyModal() {
            document.getElementById('caseStudyModal').classList.remove('hidden');
        }

        function closeCaseStudyModal() {
            document.getElementById('caseStudyModal').classList.add('hidden');
        }

        // Certificate Modal
        function openCertificateModal() {
            document.getElementById('certificateModal').classList.remove('hidden');
        }

        function closeCertificateModal() {
            document.getElementById('certificateModal').classList.add('hidden');
        }

        // Filter References
        function filterRef(category) {
            document.querySelectorAll('.ref-filter-btn').forEach(btn => {
                btn.className = 'ref-filter-btn px-4 py-1.5 rounded-full text-xs font-bold bg-gray-200 dark:bg-gray-800 text-gray-700 dark:text-gray-300';
            });
            event.target.className = 'ref-filter-btn active px-4 py-1.5 rounded-full text-xs font-bold bg-lampung-green text-white';

            document.querySelectorAll('.ref-card').forEach(card => {
                if (category === 'all' || card.classList.contains(category)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }
    </script>
</body>
</html>
